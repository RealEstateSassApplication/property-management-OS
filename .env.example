# PostgreSQL
POSTGRES_DB=property_os
POSTGRES_USER=property_os
POSTGRES_PASSWORD=property_os
DATABASE_URL=postgres://property_os:property_os@localhost:5432/property_os?sslmode=disable

# API
API_ADDR=:8080
APP_ENV=development

# Production OIDC (required outside development/test)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# S3-compatible document storage. AWS credentials use the standard AWS SDK chain.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_PATH_STYLE=false

# Signed payment-provider webhook. Generate a high-entropy secret and share it only
# with the provider/adapter that signs the raw request body.
PAYMENT_WEBHOOK_SECRET=

# Notification worker. `log` is development/test only; production should use webhook
# for the existing notification bridge. Native `push` jobs are always routed through
# the Expo Push Service independently of this fallback provider.
NOTIFICATION_PROVIDER=log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_POLL_INTERVAL=5s

# Expo Push Service. The standard Expo endpoint is used when EXPO_PUSH_ENDPOINT is empty.
# EXPO_PUSH_ACCESS_TOKEN is optional unless enhanced push security is enabled for the EAS project.
EXPO_PUSH_ENDPOINT=
EXPO_PUSH_ACCESS_TOKEN=

# Next.js server-side API access / MCP development identity
API_BASE_URL=http://localhost:8080
PROPERTY_OS_API_BASE_URL=http://localhost:8080
PROPERTY_OS_ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
PROPERTY_OS_USER_ID=22222222-2222-2222-2222-222222222222
PROPERTY_OS_ACCESS_TOKEN=

# Local portal-only identities. Production portal traffic should use the authenticated user's access token/session instead.
PROPERTY_OS_OWNER_PORTAL_USER_ID=18181818-1818-1818-1818-181818181818
PROPERTY_OS_TENANT_PORTAL_USER_ID=19191919-1919-1919-1919-191919191919

# PostgreSQL
POSTGRES_DB=property_os
POSTGRES_USER=property_os
POSTGRES_PASSWORD=property_os
DATABASE_URL=postgres://property_os:property_os@localhost:5432/property_os?sslmode=disable

# API
API_ADDR=:8080
APP_ENV=development

# Production OIDC (required outside development/test)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# S3-compatible document storage. AWS credentials use the standard AWS SDK chain.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_PATH_STYLE=false

# Next.js server-side API access (development only)
API_BASE_URL=http://localhost:8080
PROPERTY_OS_ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
PROPERTY_OS_USER_ID=22222222-2222-2222-2222-222222222222

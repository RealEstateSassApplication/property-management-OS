# PostgreSQL
POSTGRES_DB=property_os
POSTGRES_USER=property_os
POSTGRES_PASSWORD=property_os
DATABASE_URL=postgres://property_os:property_os@localhost:5432/property_os?sslmode=disable

# API
API_ADDR=:8080
APP_ENV=development

# Production OIDC (required outside development/test)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# S3-compatible document storage. AWS credentials use the standard AWS SDK chain.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_PATH_STYLE=false

# Notification worker. `log` is development/test only; production should use webhook or a future provider adapter.
NOTIFICATION_PROVIDER=log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_POLL_INTERVAL=5s

# Next.js server-side API access / MCP development identity
API_BASE_URL=http://localhost:8080
PROPERTY_OS_API_BASE_URL=http://localhost:8080
PROPERTY_OS_ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
PROPERTY_OS_USER_ID=22222222-2222-2222-2222-222222222222
PROPERTY_OS_ACCESS_TOKEN=
